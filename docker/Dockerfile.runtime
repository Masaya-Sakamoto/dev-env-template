ARG BASE_IMAGE
FROM ${BASE_IMAGE}

WORKDIR /app

# プロジェクトの依存関係ファイルをコピー
COPY pyproject.toml uv.lock* ./

# ビルダーコンテナからコンパイル済みのSionna-RT Wheelをコピー (additional_contexts経由)
COPY --from=builder /wheels /wheels

# uvを使ってシステムPythonに依存パッケージとSionna-RTをインストール
RUN uv pip install --system --no-cache -r pyproject.toml && \
    uv pip install --system --no-cache /wheels/*.whl

# アプリケーションコードのコピー (変更頻度が高いので最後に)
COPY src/ /app/src/
COPY configs/ /app/configs/

# 実行時の環境変数
ENV PYTHONPATH=/app/src

# 実行時バイナリのエントリーポイント
CMD ["python", "-m", "plateau_rt.cli.main"]
